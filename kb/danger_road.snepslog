; Road-aware danger rules, used with `python -m yolo_sneps --road`. One statement per line.
;
; Besides the facts kb/danger.snepslog uses, the scene supplies onroad(x) / onsidewalk(x) for
; people, from a street-scene segmentation model, and near(a, b) for objects standing close
; together without overlapping in the picture.
;
; A person counts as in danger only when standing on the road. On a pavement, being in front of
; a vehicle in the picture usually means standing beside it (a parked bus, a delivery van).

; Which detected classes are people, vehicles and hazards (vehicles and large animals). Cats and
; dogs are left out: a pet on a lap or a leash is not a collision hazard.
; Each class is listed under every category it belongs to, so the rule below needs one step. SNePS
; 2.7 does not finish a chain of two steps through the same rule (car -> vehicle -> hazard) within
; one ask: dangerous(?x) then finds nothing, until a later query happens to fill in the gap.
subclass(person, human).
subclass(bicycle, vehicle).
subclass(car, vehicle).
subclass(motorcycle, vehicle).
subclass(bus, vehicle).
subclass(train, vehicle).
subclass(truck, vehicle).
subclass(bicycle, hazard).
subclass(car, hazard).
subclass(motorcycle, hazard).
subclass(bus, hazard).
subclass(train, hazard).
subclass(truck, hazard).
subclass(horse, hazard).
subclass(cow, hazard).
subclass(sheep, hazard).
subclass(elephant, hazard).
subclass(bear, hazard).
subclass(zebra, hazard).
subclass(giraffe, hazard).

; An instance of a class is an instance of the category the class belongs to.
all(i,c,d)({isa(i,c), subclass(c,d)} &=> {isa(i,d)}).

; On the road, in front of or right next to a vehicle or a large animal: dangerous.
all(x,y)({infrontof(x,y), onroad(x), isa(x,human), isa(y,hazard)} &=> {dangerous(x)}).
all(x,y)({near(x,y), onroad(x), isa(x,human), isa(y,hazard)} &=> {dangerous(x)}).
all(x,y)({near(y,x), onroad(x), isa(x,human), isa(y,hazard)} &=> {dangerous(x)}).

; Partly hidden behind a vehicle: drivers cannot see this person (the "dart-out" case).
all(x,y)({infrontof(y,x), isa(x,human), isa(y,vehicle)} &=> {hidden(x)}).

; A dangerous position seen with a confident detection (confidence >= 0.5) raises an alert.
all(x)({dangerous(x), confident(x)} &=> {alert(x)}).
